# The Aperture Method — environment variables.
# Copy to `.env.local` for local dev, and set the same keys in Vercel
# (Project → Settings → Environment Variables) for production.
# Never commit real secrets.

# Canonical site URL (no trailing slash). Drives metadata, canonicals, sitemap, OG.
NEXT_PUBLIC_SITE_URL=https://aperturemethod.com

# Booking — Calendly scheduling link. Falls back to the hardcoded link if unset.
# Set the Calendly event Location to Google Meet for automatic video links.
NEXT_PUBLIC_SCHEDULER_URL=https://calendly.com/fenhow/30min

# Form delivery — endpoints that receive submissions (HubSpot, Formspree, a
# serverless function, etc.). Until these are set, forms accept input but do
# NOT deliver it anywhere.
CONTACT_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=

# --- Optional / post-launch ---
# Analytics measurement ID (consent scaffolding already present in the app)
# NEXT_PUBLIC_GA4_ID=
# CMS — Sanity
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production

# Method Lab — passphrase for the private /method-lab area (Agent Workflow Map).
# Server-side only: do NOT prefix with NEXT_PUBLIC_. Must be at least 8 chars,
# or the area stays closed. Changing this value revokes every existing session.
METHOD_LAB_PASSWORD=

# The Reality Check emails its written breakdown over the same SMTP relay as the
# rest of the site (SMTP_HOST / SMTP_USER / SMTP_PASS above). Until that is set,
# the form tells the visitor honestly that it could not send, rather than
# claiming success. Check /api/email-test to confirm the relay works.

# ---------------------------------------------------------------------------
# Supabase — client portal, intake save-and-resume, signed-PDF storage
# ---------------------------------------------------------------------------
# WITHOUT THESE, SAVE-AND-RESUME IS SILENTLY DISABLED. /api/intake/draft returns
# 503, the form keeps accepting input, and nothing is stored server-side.
# Apply supabase/migrations/0001_intake_drafts.sql first — see supabase/RUNBOOK.md.
# Dashboard → Settings → API.

# Project URL. Also used server-side (src/lib/supabase/env.ts) — there is no
# separate SUPABASE_URL variable; this one key serves both.
NEXT_PUBLIC_SUPABASE_URL=

# "anon public" key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key. SERVER ONLY — bypasses Row-Level Security.
# Never prefix with NEXT_PUBLIC_. In Vercel, scope it to Server only.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# SMTP relay — resume links, submission notifications, Reality Check
# ---------------------------------------------------------------------------
# Absent => the client never receives their resume link and you are never told
# an intake was submitted. The PDF still generates, so nothing hard-fails.
# Verify the relay at /api/email-test.
SMTP_HOST=
SMTP_PORT=587
# "true" only for port 465 (implicit TLS). Leave blank for 587 (STARTTLS).
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Envelope sender. Falls back to SMTP_USER if unset.
ONBOARDING_FROM_EMAIL=hello@aperturemethod.com
# Where completed intakes and agreements are announced. Falls back to SMTP_USER.
ONBOARDING_NOTIFY_EMAIL=hello@aperturemethod.com
